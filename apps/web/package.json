    "next": "15.5.20",
    "next-auth": "4.24.15",
    "nodemailer": "7.0.13",
    "postgres": "3.4.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.24",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "drizzle-kit": "0.30.6",
    "tsx": "4.19.2",
