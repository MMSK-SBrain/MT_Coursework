# Postgres (docker compose in this folder exposes 54329)
DATABASE_URL=postgres://cg:cg@localhost:54329/cg
# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
# Google sign-in (optional in development; the button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic-link email (optional in development: links are printed to the server log when unset)
EMAIL_SERVER=
EMAIL_FROM="Course Generator <no-reply@reynlab.com>"
# Comma-separated emails that get the admin role (feedback admin page)
ADMIN_EMAILS=
# Run queued jobs inside the web process (default: on in development, off in production).
# Set to 0 and run `pnpm --filter @cg/web worker` for a separate worker.
INLINE_JOBS=
# Where uploads and generated files are written
STORAGE_DIR=.data
# Generation: real models via OpenRouter when set; otherwise the deterministic harness MockStages
OPENROUTER_API_KEY=
# Further-learning videos from the YouTube Data API (fixture links when unset)
YOUTUBE_API_KEY=
# Worked-example courses for few-shot prompts (repo courses/ directory)
CG_COURSES_DIR=
